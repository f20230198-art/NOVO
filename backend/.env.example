# AI wording is optional; with no key, answers come from the built-in templates and rules.
# Every Groq/Gemini key set below joins one rotating pool: each call goes to the next key,
# and a rate-limited key is skipped until it cools down. More keys = more free quota.
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
# Or any number of keys, comma-separated:
GROQ_API_KEYS=
GEMINI_API_KEY=
GEMINI_API_KEYS=
# Optional: override the default model (openai/gpt-oss-120b on Groq, gemini-2.5-flash on Gemini).
LLM_MODEL=
# Voice assistant limits per fisher (SOS and trips are never limited).
ASSISTANT_PER_MINUTE=6
ASSISTANT_PER_DAY=120
COMMUNITY_PER_MINUTE=8
ADMIN_KEY=change-me
DEMO_MODE=true
DATABASE_URL=sqlite:///./seasafe.db
MONITOR_INTERVAL=60
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
TELEGRAM_BOT_TOKEN=
