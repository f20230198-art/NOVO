# Address of the Sea Safe backend, reachable from the phone (your laptop's Wi-Fi IP;
# start-demo.ps1 prints it). In a native build (APK) it is baked in at build time; in Expo Go it is read when Metro starts. It can be changed
# in the app at any time: first screen -> Server settings, or long-press the title on
# Home/Profile -> Simulation -> Server settings.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8001
